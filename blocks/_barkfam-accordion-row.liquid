{%- doc -%}
  Renders one row of the BarkFam product accordion as a native <details>
  element. The body is either the product description or the row's own rich
  text. Rows in the same section share a name, so opening one closes the
  others. Styled by blocks/barkfam-accordion.liquid.

  Block settings: heading, source, content, open_by_default.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- liquid
  if block.settings.source == 'description'
    assign row_content = closest.product.description
  else
    assign row_content = block.settings.content
  endif
-%}

{%- if block.settings.heading != blank and row_content != blank -%}
  <details
    class="bf-accordion__row"
    name="bf-accordion-{{ section.id }}"
    {% if block.settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="bf-accordion__summary">
      <span>{{ block.settings.heading | escape }}</span>
      <span class="bf-accordion__icon" aria-hidden="true">
        <span class="bf-accordion__icon-plus">+</span>
        <span class="bf-accordion__icon-minus">−</span>
      </span>
    </summary>
    <div class="bf-accordion__content">{{ row_content }}</div>
  </details>
{%- endif -%}

{% schema %}
{
  "name": "t:names.barkfam_accordion_row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_accordion_shipping"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.barkfam_content_source",
      "options": [
        {
          "value": "custom",
          "label": "t:options.barkfam_custom_text"
        },
        {
          "value": "description",
          "label": "t:options.barkfam_product_description"
        }
      ],
      "default": "custom"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.text",
      "default": "t:html_defaults.barkfam_accordion_shipping",
      "visible_if": "{{ block.settings.source == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:settings.open_row_by_default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_accordion_row"
    }
  ]
}
{% endschema %}
