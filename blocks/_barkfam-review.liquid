{%- doc -%}
  Renders one customer review in the BarkFam reviews slider: star rating, quote,
  and the reviewer's avatar, name and detail line. Every field starts empty, so
  nothing shows on the storefront until a real review is entered. Styled by
  sections/barkfam-reviews.liquid.

  Block settings: rating, quote, name, detail, avatar.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- if block.settings.quote != blank -%}
  <figure class="bf-review" {{ block.shopify_attributes }}>
    <div class="bf-stars bf-review__stars">
      <span class="visually-hidden">{{ 'accessibility.rating' | t: rating: block.settings.rating }}</span>
      {%- for star in (1..5) -%}
        <svg
          class="{% if star > block.settings.rating %}bf-stars__empty{% endif %}"
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/>
        </svg>
      {%- endfor -%}
    </div>

    <blockquote class="bf-review__quote">
      <p>“{{ block.settings.quote | escape }}”</p>
    </blockquote>

    <figcaption class="bf-review__author">
      <span class="bf-review__avatar">
        {%- if block.settings.avatar != blank -%}
          {{
            block.settings.avatar
            | image_url: width: 88
            | image_tag: widths: '44, 88', sizes: '44px', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
      </span>
      <span class="bf-review__who">
        {%- if block.settings.name != blank -%}
          <span class="bf-review__name">{{ block.settings.name | escape }}</span>
        {%- endif -%}
        {%- if block.settings.detail != blank -%}
          <span class="bf-review__detail">{{ block.settings.detail | escape }}</span>
        {%- endif -%}
      </span>
    </figcaption>
  </figure>
{%- endif -%}

{% schema %}
{
  "name": "t:names.barkfam_review",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "t:settings.barkfam_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:settings.barkfam_quote"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:settings.barkfam_reviewer_name"
    },
    {
      "type": "text",
      "id": "detail",
      "label": "t:settings.barkfam_reviewer_detail",
      "info": "t:info.barkfam_reviewer_detail"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "t:settings.barkfam_reviewer_avatar"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_review"
    }
  ]
}
{% endschema %}
