{%- doc -%}
  Renders the delivery estimate box from the approved design
  (_referencias/design/Product.dc.html): a truck icon and "Estimated delivery:
  Oct 28 – Nov 2", with the dates counted in calendar days from today, plus a
  line of supporting text. Days and text are editable.

  Block settings: label, min_days, max_days, text.

  @example
  {% content_for 'block', type: 'barkfam-delivery', id: 'delivery' %}
{%- enddoc -%}

{%- liquid
  assign today = 'now' | date: '%s' | plus: 0
  assign earliest = block.settings.min_days | times: 86400 | plus: today | date: '%b %-d'
  assign latest = block.settings.max_days | times: 86400 | plus: today | date: '%b %-d'
-%}

<div class="bf-delivery" {{ block.shopify_attributes }}>
  <span class="bf-delivery__icon">
    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/>
    </svg>
  </span>
  <span class="bf-delivery__text">
    <span class="bf-delivery__title">{{ block.settings.label | escape }} {{ earliest }} – {{ latest }}</span>
    {%- if block.settings.text != blank -%}
      <span class="bf-delivery__note">{{ block.settings.text | escape }}</span>
    {%- endif -%}
  </span>
</div>

{% stylesheet %}
  .bf-delivery {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--bf-line);
    border-radius: 16px;
    background-color: var(--bf-surface);
    color: var(--bf-ink);
    font-family: var(--bf-font-body);
    font-size: 14px;
    line-height: 1.55;
  }

  .bf-delivery__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background-color: var(--bf-alt);
    color: var(--bf-accent);
  }

  .bf-delivery__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .bf-delivery__title {
    font-weight: 600;
  }

  .bf-delivery__note {
    color: var(--bf-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_delivery",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_delivery_label"
    },
    {
      "type": "range",
      "id": "min_days",
      "label": "t:settings.barkfam_min_days",
      "min": 1,
      "max": 45,
      "step": 1,
      "unit": "d",
      "default": 5
    },
    {
      "type": "range",
      "id": "max_days",
      "label": "t:settings.barkfam_max_days",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "default": 10
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.barkfam_delivery_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_delivery"
    }
  ]
}
{% endschema %}
