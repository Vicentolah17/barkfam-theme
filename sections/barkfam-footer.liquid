{% comment %}
  Section contract.
  The dark footer from the approved design (_referencias/design/Footer.dc.html):
  a row with the footer logo and tagline, then the newsletter and link columns,
  then the copyright line.

  The logo is the theme's own footer logo setting (Theme settings → Logo), so the
  light version is uploaded once. The newsletter is Shopify's native customer
  form. Link columns are _barkfam-footer-column blocks holding link blocks, so
  they are edited in the theme editor instead of through navigation menus.

  @example
  <!-- sections/footer-group.json, the only section in the footer group -->
{% endcomment %}

{% render 'barkfam-ui' %}

{%- liquid
  assign footer_logo = settings.logo_footer | default: settings.logo_inverse
  assign newsletter_id = 'BarkfamNewsletter-' | append: section.id
  assign column_count = section.blocks.size | at_least: 1
-%}

<div
  class="bf-section bf-footer"
  style="
    {% render 'barkfam-surface', background: section.settings.background_color %}
    --bf-footer-logo-height: {{ section.settings.logo_height }}px;
    --bf-footer-columns: {{ column_count }};
  "
>
  <div class="bf-container bf-footer__inner">
    <div class="bf-footer__top">
      <a class="bf-footer__logo" href="{{ routes.root_url }}">
        {%- if footer_logo != blank -%}
          {%- comment -%} One 120px-tall file covers the 20–60px display range at 2x {%- endcomment -%}
          {{ footer_logo | image_url: height: 120 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span class="bf-footer__logo-text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="bf-footer__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    <div class="bf-footer__grid">
      <div class="bf-footer__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <p class="bf-footer__heading">{{ section.settings.newsletter_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="bf-footer__note">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'bf-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="bf-footer__field">
            <label for="{{ newsletter_id }}" class="visually-hidden">{{ 'blocks.email_signup.label' | t }}</label>
            <input
              id="{{ newsletter_id }}"
              class="bf-footer__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
              required
              {% if form.errors and form.id == blank %}
                aria-invalid="true"
                aria-describedby="{{ newsletter_id }}-message"
              {% elsif form.posted_successfully? and form.id == blank %}
                aria-describedby="{{ newsletter_id }}-message"
              {% endif %}
            >
            <button class="bf-footer__submit" type="submit" aria-label="{{ 'actions.sign_up' | t }}">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </button>
          </div>

          {%- if form.errors and form.id == blank -%}
            <p id="{{ newsletter_id }}-message" class="bf-footer__message" role="alert">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- elsif form.posted_successfully? and form.id == blank -%}
            <p id="{{ newsletter_id }}-message" class="bf-footer__message" role="status">
              {{- 'blocks.email_signup.success' | t -}}
            </p>
          {%- endif -%}
        {%- endform -%}

        <div class="bf-footer__socials">
          {%- for position in (1..3) -%}
            {%- liquid
              assign social_label_key = 'social_' | append: position | append: '_label'
              assign social_url_key = 'social_' | append: position | append: '_url'
              assign social_label = section.settings[social_label_key]
              assign social_url = section.settings[social_url_key]
            -%}
            {%- if social_label != blank and social_url != blank -%}
              <a class="bf-footer__social" href="{{ social_url }}" target="_blank" rel="noopener">
                {{- social_label | escape -}}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {% content_for 'blocks' %}
    </div>

    <div class="bf-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</span>
    </div>
  </div>
</div>

{% stylesheet %}
  .bf-footer {
    background-color: var(--bf-surface-bg, var(--bf-footer));
    color: var(--bf-ink);
  }

  .bf-footer__inner {
    padding-block: var(--bf-py) 32px;
  }

  .bf-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block-end: 48px;
    border-block-end: 1px solid var(--bf-line);
  }

  .bf-footer__logo {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .bf-footer__logo img {
    display: block;
    width: auto;
    height: var(--bf-footer-logo-height, 30px);
  }

  .bf-footer__logo-text {
    font-family: var(--bf-font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  .bf-footer__tagline {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: var(--bf-h3);
    font-weight: 500;
  }

  .bf-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    padding-block: 48px;
  }

  .bf-footer__newsletter {
    display: flex;
    flex-direction: column;
    gap: 16px;
    grid-column: 1 / -1;
  }

  .bf-footer__heading {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: 15px;
    font-weight: 600;
  }

  .bf-footer__heading--list {
    margin-block-end: 4px;
  }

  .bf-footer__note {
    max-width: 340px;
    margin: 0;
    color: var(--bf-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .bf-footer__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bf-footer__field {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 380px;
    padding-block: 6px;
    padding-inline: 20px 6px;
    border: 1px solid rgb(var(--bf-ink-rgb) / 0.2);
    border-radius: 999px;
    background-color: rgb(var(--bf-ink-rgb) / 0.08);
  }

  .bf-footer__field:focus-within {
    outline: 2px solid var(--bf-ink);
    outline-offset: 2px;
  }

  /* Two classes to beat Horizon's global input:not([type='checkbox'], [type='radio']) fill */
  .bf-footer__field .bf-footer__input {
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--bf-ink);
    font-family: var(--bf-font-body);
    font-size: 14px;
  }

  .bf-footer__input::placeholder {
    color: var(--bf-muted);
    opacity: 1;
  }

  .bf-footer__submit {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background-color: var(--bf-ink);
    color: var(--bf-surface-bg, var(--bf-footer));
    cursor: pointer;
  }

  .bf-footer__message {
    margin: 0;
    font-size: 13px;
  }

  .bf-footer__column {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
  }

  .bf-footer__links {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bf-footer__links {
    flex-direction: column;
    gap: 12px;
  }

  .bf-footer__links a {
    color: var(--bf-muted);
    text-decoration: none;
  }

  .bf-footer__email {
    margin-block-start: 4px;
    color: var(--bf-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .bf-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block-start: 8px;
  }

  .bf-footer__socials:empty {
    display: none;
  }

  .bf-footer__social {
    padding: 8px 14px;
    border: 1px solid rgb(var(--bf-ink-rgb) / 0.3);
    border-radius: 999px;
    color: var(--bf-ink);
    font-size: 13px;
    line-height: 1.55;
    text-decoration: none;
  }

  .bf-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--bf-line);
    color: rgb(var(--bf-ink-rgb) / 0.7);
    font-size: 13px;
  }

  @media screen and (min-width: 750px) {
    .bf-footer__grid {
      grid-template-columns: 1.4fr repeat(var(--bf-footer-columns, 3), minmax(0, 1fr));
    }

    .bf-footer__newsletter {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_footer",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "_barkfam-footer-column"
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.barkfam_footer_logo_location"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:settings.barkfam_logo_height",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:settings.barkfam_tagline",
      "default": "t:text_defaults.barkfam_footer_tagline"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_footer_newsletter_heading"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "t:settings.text",
      "default": "t:text_defaults.barkfam_footer_newsletter_text"
    },
    {
      "type": "text",
      "id": "social_1_label",
      "label": "t:settings.barkfam_social_1_label",
      "default": "Instagram"
    },
    {
      "type": "url",
      "id": "social_1_url",
      "label": "t:settings.barkfam_social_1_url"
    },
    {
      "type": "text",
      "id": "social_2_label",
      "label": "t:settings.barkfam_social_2_label",
      "default": "TikTok"
    },
    {
      "type": "url",
      "id": "social_2_url",
      "label": "t:settings.barkfam_social_2_url"
    },
    {
      "type": "text",
      "id": "social_3_label",
      "label": "t:settings.barkfam_social_3_label"
    },
    {
      "type": "url",
      "id": "social_3_url",
      "label": "t:settings.barkfam_social_3_url"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_bottom_bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:settings.barkfam_copyright",
      "info": "t:info.barkfam_copyright",
      "default": "t:text_defaults.barkfam_footer_copyright"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.color5 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_footer",
      "category": "t:categories.footer",
      "blocks": {
        "column_1": {
          "type": "_barkfam-footer-column"
        },
        "column_2": {
          "type": "_barkfam-footer-column"
        },
        "column_3": {
          "type": "_barkfam-footer-column"
        }
      },
      "block_order": ["column_1", "column_2", "column_3"]
    }
  ]
}
{% endschema %}
