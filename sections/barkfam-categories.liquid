{% comment %}
  Section contract.
  "Shop by Category" from the approved design (_referencias/design/Home.dc.html,
  "Categories"): a centred pill and heading over a grid of bordered category
  cards, four across on desktop and two on mobile. Each card is a
  _barkfam-category block with its own collection, title and image.

  @example
  <!-- templates/index.json, right after the hero, with four category blocks -->
{% endcomment %}

{% render 'barkfam-ui' %}

<div
  class="bf-section bf-categories"
  style="{% render 'barkfam-surface', background: section.settings.background_color %}"
>
  <div class="bf-container">
    {%- if section.settings.pill != blank or section.settings.heading != blank -%}
      <div class="bf-heading-group">
        {%- if section.settings.pill != blank -%}
          <span class="bf-pill"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bf-categories__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .bf-categories {
    padding-block-start: var(--bf-py);
    background-color: var(--bf-surface-bg, transparent);
  }

  .bf-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--bf-gap);
  }

  .bf-category {
    display: flex;
    flex-direction: column;
    gap: var(--bf-gap);
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--bf-line);
    border-radius: var(--bf-r-card);
    background-color: var(--bf-surface);
    color: var(--bf-ink);
    text-decoration: none;
  }

  .bf-category__title {
    min-height: 2.3em;
    font-family: var(--bf-font-display);
    font-size: var(--bf-h3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .bf-category__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
  }

  .bf-category__image--placeholder {
    background-color: rgb(var(--bf-ink-rgb) / 0.05);
  }

  @media screen and (min-width: 750px) {
    .bf-categories__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .bf-category {
      padding: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_categories",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_barkfam-category"
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_categories_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_categories_heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_categories",
      "category": "t:categories.collections",
      "blocks": {
        "grooming": {
          "type": "_barkfam-category",
          "settings": {
            "title": "t:text_defaults.barkfam_category_grooming"
          }
        },
        "food": {
          "type": "_barkfam-category",
          "settings": {
            "title": "t:text_defaults.barkfam_category_food"
          }
        },
        "walks": {
          "type": "_barkfam-category",
          "settings": {
            "title": "t:text_defaults.barkfam_category_walks"
          }
        },
        "rest": {
          "type": "_barkfam-category",
          "settings": {
            "title": "t:text_defaults.barkfam_category_rest"
          }
        }
      },
      "block_order": ["grooming", "food", "walks", "rest"]
    }
  ]
}
{% endschema %}
