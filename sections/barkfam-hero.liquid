{% comment %}
  Section contract.
  Homepage hero from the chosen BarkFam design (Claude design "H1", Downloads/barkfam-hero):
  a full-width photo with the brand word set huge in solid colour between the
  background and a same-size cut-out of the dog, so the dog stands in front of
  the letters. A copy card with a spinning sticker sits on the photo, a product
  chip floats in a corner, and a band of short lines scrolls along the bottom.

  The photo and cut-out must share size and framing; both use object-fit: cover
  on the same box. They are the merchant's uploads, or the theme's own
  assets/workspaceartifactswallpaper_dog_4k.jpg and assets/barkfam-hero-dog.webp.
  Band lines are section blocks, rendered four times for a seamless loop.
  Reduced motion stops the sticker, chip and band.

  @example
  <!-- First section of templates/index.json, with the chip product picked -->
{% endcomment %}

{% render 'barkfam-ui' %}

{%- liquid
  assign chip_product = section.settings.product
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url
  assign sticker_path_id = 'BarkfamSticker-' | append: section.id
  assign word_font = section.settings.wordmark_font

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign default_bg = 'workspaceartifactswallpaper_dog_4k.jpg'
  assign default_dog = 'barkfam-hero-dog.webp'
-%}

{% style %}
  {{ word_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .bf-hero__word {
    font-family: {{ word_font.family }}, {{ word_font.fallback_families }};
    font-weight: {{ word_font.weight }};
  }
{% endstyle %}

<div
  class="bf-section bf-hero"
  style="
    {% render 'barkfam-surface', background: section.settings.background_color %}
    {% if section.settings.ghost_color != blank %}--bf-hero-word: {{ section.settings.ghost_color }};{% endif %}
    --bf-hero-subject: {{ section.settings.subject_top | divided_by: 100.0 }};
  "
>
  <div class="bf-hero__stage">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          class: 'bf-hero__bg',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: '',
          loading: image_loading,
          fetchpriority: image_priority
      }}
    {%- else -%}
      <img
        class="bf-hero__bg"
        src="{{ default_bg | asset_img_url: '2000x' }}"
        srcset="
          {{ default_bg | asset_img_url: '750x' }} 750w,
          {{ default_bg | asset_img_url: '1100x' }} 1100w,
          {{ default_bg | asset_img_url: '1500x' }} 1500w,
          {{ default_bg | asset_img_url: '2000x' }} 2000w
        "
        sizes="100vw"
        width="2000"
        height="1125"
        alt=""
        loading="{{ image_loading }}"
        fetchpriority="{{ image_priority }}"
      >
    {%- endif -%}

    {%- if section.settings.ghost_text != blank -%}
      <p class="bf-hero__word" aria-hidden="true">{{ section.settings.ghost_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cutout_image != blank -%}
      {{
        section.settings.cutout_image
        | image_url: width: 2400
        | image_tag:
          class: 'bf-hero__dog',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.image_alt,
          loading: image_loading
      }}
    {%- else -%}
      <img
        class="bf-hero__dog"
        src="{{ default_dog | asset_url }}"
        width="2000"
        height="1125"
        alt="{{ section.settings.image_alt | escape }}"
        loading="{{ image_loading }}"
      >
    {%- endif -%}

    {%- if section.settings.show_chip and chip_product != blank -%}
      <a class="bf-hero__chip" href="{{ chip_product.url }}">
        {%- if chip_product.featured_media != blank -%}
          {{
            chip_product.featured_media.preview_image
            | image_url: width: 120
            | image_tag: class: 'bf-hero__chip-image', widths: '60, 120', sizes: '52px', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
        <span class="bf-hero__chip-text">
          <span class="bf-hero__chip-title">{{ chip_product.title | escape }}</span>
          <strong>{{ chip_product.price | money }}</strong>
        </span>
      </a>
    {%- endif -%}
  </div>

  <div class="bf-hero__card">
    {%- if section.settings.show_sticker and section.settings.sticker_text != blank -%}
      <div class="bf-hero__sticker" aria-hidden="true">
        <svg class="bf-hero__sticker-ring" viewBox="0 0 150 150">
          <defs>
            <path id="{{ sticker_path_id }}" d="M75,75 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0"/>
          </defs>
          <circle cx="75" cy="75" r="74"/>
          <text>
            <textPath href="#{{ sticker_path_id }}" textLength="336" lengthAdjust="spacing">
              {{- section.settings.sticker_text | upcase | escape -}}
            </textPath>
          </text>
        </svg>
        <span class="bf-hero__sticker-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor">
            <ellipse cx="7" cy="8" rx="2" ry="2.6"/><ellipse cx="12" cy="6" rx="2" ry="2.6"/><ellipse cx="17" cy="8" rx="2" ry="2.6"/><ellipse cx="4.6" cy="12.8" rx="1.8" ry="2.3"/><ellipse cx="19.4" cy="12.8" rx="1.8" ry="2.3"/><path d="M12 11c-3 0-6.2 4.1-6.2 6.6 0 1.9 1.6 2.6 3 2.6 1.3 0 2-.6 3.2-.6s1.9.6 3.2.6c1.4 0 3-.7 3-2.6C18.2 15.1 15 11 12 11z"/>
          </svg>
        </span>
      </div>
    {%- endif -%}

    {%- if section.settings.pill != blank -%}
      <span class="bf-pill"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="bf-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="bf-hero__text">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="bf-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="bf-btn bf-btn--primary" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="bf-btn bf-btn--outline" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- capture band_items -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="bf-hero__band-item">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <div class="bf-hero__band">
      <p class="visually-hidden">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}. </span>
        {%- endfor -%}
      </p>
      <div class="bf-hero__track" aria-hidden="true">
        <div class="bf-hero__group">{{ band_items }}{{ band_items }}</div>
        <div class="bf-hero__group">{{ band_items }}{{ band_items }}</div>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .bf-hero {
    --bf-hero-word-size: 23vw;
    --bf-hero-word-gap: 12px;
    --bf-hero-header-clear: 60px;
    --bf-hero-gutter: clamp(24px, 3.4vw, 56px);
    --bf-hero-band-height: 52px;

    position: relative;
    /* The spinning sticker's corners sweep past the edge on phones; clip sideways only */
    overflow-x: clip;
    background-color: var(--bf-surface-bg, var(--bf-bg));
  }

  /* Photo stage: background, word and cut-out share one box */
  .bf-hero__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--bf-alt);
    container-type: size;
  }

  /* Two classes so Horizon's global img rules (height: auto, max-width) cannot resize the layers */
  .bf-hero__stage .bf-hero__bg,
  .bf-hero__stage .bf-hero__dog {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 48% 50%;
  }

  .bf-hero__stage .bf-hero__dog {
    z-index: 2;
    pointer-events: none;
  }

  /* The word sits whole in the sky between the header and the dog's head.
     The photo is a 16:9 frame covering the stage, so its rendered height is
     max(stage height, 56.25% of stage width), and the head sits --bf-hero-subject
     of the way down that frame. The word's glyphs end 0.83em below its box top and
     stand about 0.77em tall; it shrinks only when that sky band is too short. */
  .bf-hero__word {
    --bf-hero-frame: max(100cqh, 56.25cqw);
    --bf-hero-head: calc((100cqh - var(--bf-hero-frame)) / 2 + var(--bf-hero-subject, 0.37) * var(--bf-hero-frame));
    --bf-hero-word-fit: calc(
      (var(--bf-hero-head) - var(--bf-hero-header-clear) - 2 * var(--bf-hero-word-gap)) / 0.77
    );

    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(var(--bf-hero-head) - var(--bf-hero-word-gap) - 0.83em);
    z-index: 1;
    margin: 0;
    color: var(--bf-hero-word, var(--bf-bg));
    font-size: min(var(--bf-hero-word-size), var(--bf-hero-word-fit));
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  /* Copy card: below the photo on mobile, floating on it from tablet up */
  .bf-hero__card {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin: -36px 16px 24px;
    padding: 24px 22px;
    border-radius: 24px;
    background-color: var(--bf-bg);
    box-shadow: 0 18px 40px rgb(30 30 30 / 0.18);
    color: var(--bf-ink);
  }

  .bf-hero__title {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: clamp(28px, 2.7vw, 40px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .bf-hero__text {
    margin: 0;
    color: var(--bf-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .bf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-start: 4px;
  }

  .bf-hero__actions .bf-btn {
    padding-inline: 22px;
    font-size: 15px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .bf-hero__actions .bf-btn:hover {
    transform: translateY(-2px);
  }

  /* Spinning sticker on the card's corner */
  .bf-hero__sticker {
    position: absolute;
    z-index: 4;
    inset-block-start: -78px;
    inset-inline-end: -6px;
    width: 104px;
    height: 104px;
    color: var(--bf-accent);
  }

  .bf-hero__sticker-ring {
    display: block;
    width: 100%;
    height: 100%;
    animation: bf-hero-spin 14s linear infinite;
  }

  .bf-hero__sticker-ring circle {
    fill: var(--bf-surface);
  }

  .bf-hero__sticker-ring text {
    fill: currentcolor;
    font-family: var(--bf-font-display);
    font-size: 14px;
    font-weight: 700;
  }

  .bf-hero__sticker-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Floating product chip, desktop only */
  .bf-hero__chip {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--bf-hero-gutter);
    inset-inline-start: var(--bf-hero-gutter);
    display: none;
    align-items: center;
    gap: 12px;
    max-width: 300px;
    padding: 8px 18px 8px 8px;
    border-radius: 999px;
    background-color: var(--bf-surface);
    box-shadow: 0 12px 32px rgb(30 30 30 / 0.18);
    color: var(--bf-ink);
    text-decoration: none;
    animation: bf-hero-float 5s ease-in-out infinite;
  }

  .bf-hero__chip .bf-hero__chip-image {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background-color: var(--bf-alt);
    object-fit: cover;
  }

  .bf-hero__chip-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 13px;
    line-height: 1.3;
  }

  .bf-hero__chip-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .bf-hero__chip-text strong {
    font-weight: 600;
  }

  /* Moving band */
  .bf-hero__band {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    height: var(--bf-hero-band-height);
    overflow: hidden;
    background-color: var(--bf-accent);
    color: var(--bf-bg);
  }

  .bf-hero__track {
    display: flex;
    width: max-content;
    animation: bf-hero-marquee 28s linear infinite;
  }

  .bf-hero__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    font-family: var(--bf-font-display);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }

  .bf-hero__band-item {
    padding-inline: 22px;
  }

  .bf-hero__band-item::after {
    content: '✦';
    margin-inline-start: 44px;
    opacity: 0.7;
  }

  @keyframes bf-hero-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes bf-hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes bf-hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }

    50% {
      transform: translateY(-10px) rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bf-hero__track,
    .bf-hero__sticker-ring,
    .bf-hero__chip {
      animation: none;
    }
  }

  @media screen and (min-width: 750px) {
    .bf-hero {
      --bf-hero-word-size: clamp(110px, 22.5vw, 340px);
      --bf-hero-word-gap: 16px;
      --bf-hero-header-clear: 76px;
      --bf-hero-band-height: 64px;
    }

    .bf-hero__stage {
      aspect-ratio: 16 / 9;
      min-height: 600px;
      max-height: 860px;
    }

    .bf-hero__stage .bf-hero__bg,
    .bf-hero__stage .bf-hero__dog {
      object-position: 50% 50%;
    }

    .bf-hero__card {
      position: absolute;
      inset-block-end: calc(var(--bf-hero-band-height) + var(--bf-hero-gutter));
      inset-inline-end: var(--bf-hero-gutter);
      width: min(400px, 46vw);
      margin: 0;
      padding: 28px;
    }

    .bf-hero__sticker {
      inset-block-start: -64px;
      inset-inline: -64px auto;
      width: 132px;
      height: 132px;
    }

    .bf-hero__chip {
      display: flex;
    }

    .bf-hero__actions .bf-btn {
      height: 50px;
      padding-inline: 26px;
    }

    .bf-hero__group {
      font-size: 19px;
    }
  }

  @media screen and (min-width: 1025px) {
    .bf-hero__card {
      width: min(440px, 36vw);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_hero",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "band_item",
      "name": "t:names.barkfam_band_item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "default": "t:text_defaults.barkfam_band_item"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "t:content.barkfam_hero_images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.barkfam_background_photo",
      "info": "t:info.barkfam_background_photo"
    },
    {
      "type": "image_picker",
      "id": "cutout_image",
      "label": "t:settings.barkfam_cutout",
      "info": "t:info.barkfam_cutout"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:settings.barkfam_image_description",
      "default": "t:text_defaults.barkfam_hero_image_alt"
    },
    {
      "type": "header",
      "content": "t:content.backdrop_word"
    },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "t:settings.text",
      "info": "t:info.barkfam_backdrop_word",
      "default": "t:text_defaults.barkfam_hero_word"
    },
    {
      "type": "color",
      "id": "ghost_color",
      "label": "t:settings.color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "font_picker",
      "id": "wordmark_font",
      "label": "t:settings.font",
      "default": "montserrat_n8"
    },
    {
      "type": "range",
      "id": "subject_top",
      "label": "t:settings.barkfam_subject_top",
      "info": "t:info.barkfam_subject_top",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 37
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_hero_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_hero_heading"
    },
    {
      "type": "inline_richtext",
      "id": "body",
      "label": "t:settings.text",
      "default": "t:text_defaults.barkfam_hero_body"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_primary_button"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_primary"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:settings.link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_secondary_button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_secondary"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:settings.link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_hero_extras"
    },
    {
      "type": "checkbox",
      "id": "show_sticker",
      "label": "t:settings.barkfam_show_sticker",
      "default": true
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "t:settings.barkfam_sticker_text",
      "info": "t:info.barkfam_sticker_text",
      "default": "t:text_defaults.barkfam_hero_sticker",
      "visible_if": "{{ section.settings.show_sticker }}"
    },
    {
      "type": "checkbox",
      "id": "show_chip",
      "label": "t:settings.barkfam_show_chip",
      "info": "t:info.barkfam_show_chip",
      "default": true
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_hero",
      "category": "t:categories.banners",
      "blocks": [
        {
          "type": "band_item",
          "settings": {
            "text": "t:text_defaults.barkfam_band_item"
          }
        },
        {
          "type": "band_item",
          "settings": {
            "text": "t:text_defaults.barkfam_band_delivery"
          }
        },
        {
          "type": "band_item",
          "settings": {
            "text": "t:text_defaults.barkfam_band_paws"
          }
        },
        {
          "type": "band_item",
          "settings": {
            "text": "t:text_defaults.barkfam_band_returns"
          }
        },
        {
          "type": "band_item",
          "settings": {
            "text": "t:text_defaults.barkfam_band_checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
