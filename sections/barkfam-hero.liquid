{% comment %}
  Section contract.
  Homepage hero from the approved design (_referencias/design/Home.dc.html, "Hero"):
  an oversized ghost word across the top, a text column with pill, heading, copy,
  two buttons and a price line, and a framed product image with two floating
  product cards. The image, primary link, price and card contents come from the
  products picked in the editor; nothing about a product is written in code.

  @example
  <!-- First section of templates/index.json, with the main product and two card products picked -->
{% endcomment %}

{% render 'barkfam-ui' %}

{%- liquid
  assign hero_product = section.settings.product

  # An uploaded image keeps its own alt text. The product's image is described by the
  # product title, because imported catalogues often carry file hashes as alt text.
  if section.settings.image != blank
    assign hero_image = section.settings.image
    assign hero_image_alt = section.settings.image.alt | default: hero_product.title | escape
  else
    assign hero_image = hero_product.featured_media.preview_image
    assign hero_image_alt = hero_product.title | escape
  endif

  assign primary_link = section.settings.primary_link | default: hero_product.url | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign show_price = false
  if section.settings.show_price and hero_product != blank
    assign show_price = true
  endif
-%}

<div
  class="bf-section bf-hero"
  style="{% render 'barkfam-surface', background: section.settings.background_color %}"
>
  {%- if section.settings.ghost_text != blank -%}
    <div
      class="bf-ghost bf-hero__ghost"
      style="--bf-hero-ghost-opacity: {{ section.settings.ghost_opacity | divided_by: 100.0 }};"
      aria-hidden="true"
    >
      {{- section.settings.ghost_text | escape -}}
    </div>
  {%- endif -%}

  <div class="bf-container bf-hero__inner">
    <div class="bf-hero__text">
      {%- if section.settings.pill != blank -%}
        <span class="bf-pill bf-pill--filled"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="bf-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="bf-hero__body bf-muted">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="bf-hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="bf-btn bf-btn--primary" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="bf-btn bf-btn--outline" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_price or section.settings.meta != blank -%}
        <p class="bf-hero__meta bf-muted">
          {%- if show_price -%}{{ hero_product.price | money }}{%- endif -%}
          {%- if show_price and section.settings.meta != blank %} · {% endif -%}
          {{- section.settings.meta | escape -}}
        </p>
      {%- endif -%}
    </div>

    <div class="bf-hero__media">
      <div class="bf-hero__frame">
        {%- if hero_image != blank -%}
          {{
            hero_image
            | image_url: width: 1120
            | image_tag:
              class: 'bf-hero__image',
              widths: '400, 560, 800, 1120',
              sizes: '(min-width: 750px) 560px, calc(100vw - 40px)',
              alt: hero_image_alt,
              loading: image_loading,
              fetchpriority: image_priority
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'bf-hero__image bf-hero__image--placeholder' }}
        {%- endif -%}
      </div>

      {%- for position in (1..2) -%}
        {%- liquid
          assign card_key = 'card_product_' | append: position
          assign card_product = section.settings[card_key]
        -%}
        {%- if card_product != blank -%}
          <a class="bf-hero__card bf-hero__card--{{ position }}" href="{{ card_product.url }}">
            {%- if card_product.featured_media != blank -%}
              {{
                card_product.featured_media.preview_image
                | image_url: width: 480
                | image_tag:
                  class: 'bf-hero__card-image',
                  widths: '160, 240, 320, 480',
                  sizes: '(min-width: 750px) 156px, 112px',
                  alt: '',
                  loading: 'lazy'
              }}
            {%- endif -%}
            <span class="bf-hero__card-title">{{ card_product.title | escape }}</span>
            <span class="bf-hero__card-price">{{ card_product.price | money }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .bf-hero {
    --bf-hero-ghost-top: 12px;
    --bf-hero-card-width: 132px;

    position: relative;
    overflow: hidden;
    background-color: var(--bf-surface-bg, var(--bf-alt));
  }

  .bf-hero__ghost {
    position: absolute;
    inset-block-start: var(--bf-hero-ghost-top);
    inset-inline: 0;
    color: var(--bf-surface);
    font-size: var(--bf-ghost);
    text-align: center;
    opacity: var(--bf-hero-ghost-opacity, 0.75);
  }

  .bf-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    padding-block: 72px 96px;
  }

  .bf-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  .bf-hero__heading {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: var(--bf-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .bf-hero__body {
    max-width: 460px;
    margin: 0;
    text-wrap: pretty;
  }

  .bf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 8px;
  }

  .bf-hero__meta {
    margin: 0;
    font-size: var(--bf-small);
  }

  .bf-hero__media {
    position: relative;
    min-width: 0;
  }

  .bf-hero__frame {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline-start: auto;
    overflow: hidden;
    border: 1px solid var(--bf-line);
    border-radius: var(--bf-r-lg);
    background-color: var(--bf-surface);
  }

  .bf-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bf-hero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: var(--bf-hero-card-width);
    padding: 10px;
    border-radius: var(--bf-r-card);
    background-color: var(--bf-surface);
    box-shadow: var(--bf-shadow-float);
    color: var(--bf-ink);
    text-decoration: none;
  }

  .bf-hero__card--1 {
    inset-block-end: -56px;
    inset-inline-start: 12px;
  }

  .bf-hero__card--2 {
    inset-block-end: -56px;
    inset-inline-end: 12px;
  }

  .bf-hero__card-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    object-fit: cover;
  }

  .bf-hero__card-title {
    display: -webkit-box;
    padding-inline: 4px;
    overflow: hidden;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .bf-hero__card-price {
    padding: 0 4px 4px;
    font-size: 13px;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .bf-hero {
      --bf-hero-ghost-top: 8px;
      --bf-hero-card-width: 176px;
    }

    .bf-hero__inner {
      grid-template-columns: 1fr 1.05fr;
      gap: 48px;
      padding-block: 96px;
    }

    .bf-hero__card--1 {
      inset-block-end: 48px;
      inset-inline-start: -56px;
    }

    .bf-hero__card--2 {
      inset-block: 48px auto;
      inset-inline-end: -24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_hero",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.backdrop_word"
    },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "t:settings.text",
      "info": "t:info.barkfam_backdrop_word",
      "default": "t:text_defaults.barkfam_hero_word"
    },
    {
      "type": "range",
      "id": "ghost_opacity",
      "label": "t:settings.opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "t:content.barkfam_featured_product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.barkfam_hero_product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.barkfam_hero_image"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_hero_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_hero_heading"
    },
    {
      "type": "inline_richtext",
      "id": "body",
      "label": "t:settings.text",
      "default": "t:text_defaults.barkfam_hero_body"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.barkfam_show_price",
      "default": true
    },
    {
      "type": "text",
      "id": "meta",
      "label": "t:settings.barkfam_meta",
      "default": "t:text_defaults.barkfam_hero_meta"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_primary_button"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_primary"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:settings.link",
      "info": "t:info.barkfam_primary_link"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_secondary_button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_secondary"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:settings.link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_floating_card"
    },
    {
      "type": "product",
      "id": "card_product_1",
      "label": "t:settings.barkfam_card_product_1",
      "info": "t:info.barkfam_floating_card"
    },
    {
      "type": "product",
      "id": "card_product_2",
      "label": "t:settings.barkfam_card_product_2"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.color4 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
