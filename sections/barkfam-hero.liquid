{% comment %}
  Section contract.
  Homepage hero from the approved design (_referencias/design/Home.dc.html, "Hero"):
  the brand word set large and whole across the top in the accent green, then a
  text column with pill, heading, copy, two buttons and a price line beside a row
  of three equal product cards (the main product and two more). Images, links,
  titles and prices come from the products picked in the editor; nothing about a
  product is written in code.

  @example
  <!-- First section of templates/index.json, with the main product and two card products picked -->
{% endcomment %}

{% render 'barkfam-ui' %}

{%- liquid
  assign hero_product = section.settings.product

  # An uploaded image keeps its own alt text. The product's image is described by the
  # product title, because imported catalogues often carry file hashes as alt text.
  if section.settings.image != blank
    assign hero_image = section.settings.image
    assign hero_image_alt = section.settings.image.alt | default: hero_product.title | escape
  else
    assign hero_image = hero_product.featured_media.preview_image
    assign hero_image_alt = hero_product.title | escape
  endif

  assign primary_link = section.settings.primary_link | default: hero_product.url | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign show_price = false
  if section.settings.show_price and hero_product != blank
    assign show_price = true
  endif

  # The word is sized from its length so it always fits the container whole
  assign word_chars = section.settings.ghost_text | size | at_least: 1
  assign card_sizes = '(min-width: 1200px) 200px, (min-width: 750px) 16vw, 30vw'
-%}

<div
  class="bf-section bf-hero"
  style="{% render 'barkfam-surface', background: section.settings.background_color %}"
>
  <div class="bf-container bf-hero__inner">
    {%- if section.settings.ghost_text != blank -%}
      <div class="bf-hero__word-wrap" aria-hidden="true">
        <div
          class="bf-ghost bf-hero__word"
          style="
            --bf-hero-word-chars: {{ word_chars }};
            {% if section.settings.ghost_color != blank %}--bf-hero-word-color: {{ section.settings.ghost_color }};{% endif %}
            --bf-hero-word-opacity: {{ section.settings.ghost_opacity | divided_by: 100.0 }};
          "
        >
          {{- section.settings.ghost_text | escape -}}
        </div>
      </div>
    {%- endif -%}

    <div class="bf-hero__grid">
      <div class="bf-hero__text">
        {%- if section.settings.pill != blank -%}
          <span class="bf-pill bf-pill--filled"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="bf-hero__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="bf-hero__body bf-muted">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="bf-hero__actions">
            {%- if section.settings.primary_label != blank -%}
              <a class="bf-btn bf-btn--primary" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              <a class="bf-btn bf-btn--outline" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_price or section.settings.meta != blank -%}
          <p class="bf-hero__meta bf-muted">
            {%- if show_price -%}{{ hero_product.price | money }}{%- endif -%}
            {%- if show_price and section.settings.meta != blank %} · {% endif -%}
            {{- section.settings.meta | escape -}}
          </p>
        {%- endif -%}
      </div>

      <div class="bf-hero__products">
        <a class="bf-hero__card" href="{{ primary_link }}">
          <span class="bf-hero__card-media">
            {%- if hero_image != blank -%}
              {{
                hero_image
                | image_url: width: 600
                | image_tag:
                  class: 'bf-hero__card-image',
                  widths: '160, 240, 320, 480, 600',
                  sizes: card_sizes,
                  alt: hero_image_alt,
                  loading: image_loading,
                  fetchpriority: image_priority
              }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'bf-hero__card-image' }}
            {%- endif -%}
          </span>
          {%- if hero_product != blank -%}
            <span class="bf-hero__card-title">{{ hero_product.title | escape }}</span>
            <span class="bf-hero__card-price">{{ hero_product.price | money }}</span>
          {%- endif -%}
        </a>

        {%- for position in (1..2) -%}
          {%- liquid
            assign card_key = 'card_product_' | append: position
            assign card_product = section.settings[card_key]
          -%}
          {%- if card_product != blank -%}
            <a class="bf-hero__card" href="{{ card_product.url }}">
              <span class="bf-hero__card-media">
                {%- if card_product.featured_media != blank -%}
                  {{
                    card_product.featured_media.preview_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'bf-hero__card-image',
                      widths: '160, 240, 320, 480, 600',
                      sizes: card_sizes,
                      alt: '',
                      loading: image_loading
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bf-hero__card-image' }}
                {%- endif -%}
              </span>
              <span class="bf-hero__card-title">{{ card_product.title | escape }}</span>
              <span class="bf-hero__card-price">{{ card_product.price | money }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .bf-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--bf-surface-bg, var(--bf-alt));
  }

  .bf-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 32px 72px;
  }

  /* The word fills the container width: its size follows the width and its length */
  .bf-hero__word-wrap {
    container-type: inline-size;
  }

  .bf-hero__word {
    color: var(--bf-hero-word-color, var(--bf-accent));
    font-size: min(var(--bf-ghost), calc(100cqi / (var(--bf-hero-word-chars) * 0.6)));
    text-align: center;
    opacity: var(--bf-hero-word-opacity, 1);
  }

  .bf-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .bf-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  .bf-hero__heading {
    margin: 0;
    font-family: var(--bf-font-display);
    font-size: var(--bf-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .bf-hero__body {
    max-width: 460px;
    margin: 0;
    text-wrap: pretty;
  }

  .bf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 8px;
  }

  .bf-hero__meta {
    margin: 0;
    font-size: var(--bf-small);
  }

  /* Three equal cards in one row */
  .bf-hero__products {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 12px;
    min-width: 0;
  }

  .bf-hero__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 8px;
    border-radius: var(--bf-r-card);
    background-color: var(--bf-surface);
    box-shadow: var(--bf-shadow-float);
    color: var(--bf-ink);
    text-decoration: none;
  }

  .bf-hero__card-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 10px;
    background-color: var(--bf-surface);
  }

  .bf-hero__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bf-hero__card-title {
    display: -webkit-box;
    padding-inline: 2px;
    overflow: hidden;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .bf-hero__card-price {
    margin-block-start: auto;
    padding: 0 2px 2px;
    font-size: 12px;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .bf-hero__inner {
      gap: 40px;
      padding-block: 48px 96px;
    }

    .bf-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 48px;
    }

    .bf-hero__products {
      gap: 16px;
    }

    .bf-hero__card {
      gap: 10px;
      padding: 10px;
    }

    .bf-hero__card-media {
      border-radius: 12px;
    }

    .bf-hero__card-title,
    .bf-hero__card-price {
      padding-inline: 4px;
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_hero",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.backdrop_word"
    },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "t:settings.text",
      "info": "t:info.barkfam_backdrop_word",
      "default": "t:text_defaults.barkfam_hero_word"
    },
    {
      "type": "color",
      "id": "ghost_color",
      "label": "t:settings.color",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "range",
      "id": "ghost_opacity",
      "label": "t:settings.opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:content.barkfam_featured_product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.barkfam_hero_product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.barkfam_hero_image"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_hero_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_hero_heading"
    },
    {
      "type": "inline_richtext",
      "id": "body",
      "label": "t:settings.text",
      "default": "t:text_defaults.barkfam_hero_body"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.barkfam_show_price",
      "default": true
    },
    {
      "type": "text",
      "id": "meta",
      "label": "t:settings.barkfam_meta",
      "default": "t:text_defaults.barkfam_hero_meta"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_primary_button"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_primary"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:settings.link",
      "info": "t:info.barkfam_primary_link"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_secondary_button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_hero_secondary"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:settings.link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "t:content.barkfam_floating_card"
    },
    {
      "type": "product",
      "id": "card_product_1",
      "label": "t:settings.barkfam_card_product_1",
      "info": "t:info.barkfam_floating_card"
    },
    {
      "type": "product",
      "id": "card_product_2",
      "label": "t:settings.barkfam_card_product_2"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.color4 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
