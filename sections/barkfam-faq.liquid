{% comment %}
  Section contract.
  "Questions, answered" from the approved design (_referencias/design/Home.dc.html,
  "FAQ"): a pill, heading and contact line on one side and an accordion of
  _barkfam-faq-item blocks on the other. The accordion is native <details>,
  so it needs no script; one question open at a time.

  @example
  <!-- templates/index.json, after the reviews section -->
{% endcomment %}

{% render 'barkfam-ui' %}

<div
  class="bf-section bf-faq"
  style="{% render 'barkfam-surface', background: section.settings.background_color %}"
>
  <div class="bf-container bf-faq__inner">
    <div class="bf-faq__intro">
      {%- if section.settings.pill != blank -%}
        <span class="bf-pill"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="bf-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="bf-faq__text bf-muted">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="bf-faq__list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .bf-faq {
    background-color: var(--bf-surface-bg, transparent);
  }

  .bf-faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-block: var(--bf-py);
  }

  .bf-faq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .bf-faq__text {
    max-width: 360px;
    margin: 0;
  }

  .bf-faq__text a {
    color: var(--bf-ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: currentcolor;
  }

  .bf-faq__list {
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--bf-line);
  }

  .bf-faq__item {
    border-block-end: 1px solid var(--bf-line);
  }

  .bf-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    color: var(--bf-ink);
    font-family: var(--bf-font-display);
    font-size: var(--bf-faq-q);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .bf-faq__question::-webkit-details-marker {
    display: none;
  }

  .bf-faq__question:focus-visible {
    outline: 2px solid var(--bf-accent);
    outline-offset: 3px;
  }

  .bf-faq__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--bf-line);
    border-radius: 999px;
    font-family: var(--bf-font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
  }

  .bf-faq__icon-minus,
  .bf-faq__item[open] .bf-faq__icon-plus {
    display: none;
  }

  .bf-faq__item[open] .bf-faq__icon-minus {
    display: inline;
  }

  .bf-faq__answer {
    padding-block-end: 22px;
    padding-inline-end: 48px;
    color: var(--bf-muted);
    font-size: var(--bf-small);
    line-height: 1.6;
  }

  .bf-faq__answer > * {
    margin: 0;
  }

  .bf-faq__answer > * + * {
    margin-block-start: 10px;
  }

  @media screen and (min-width: 750px) {
    .bf-faq__inner {
      grid-template-columns: 1fr 1.5fr;
      gap: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_faq",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_barkfam-faq-item"
    }
  ],
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_faq_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_faq_heading"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.barkfam_faq_text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_faq",
      "category": "t:categories.text",
      "blocks": {
        "question_1": {
          "type": "_barkfam-faq-item",
          "settings": {
            "open_by_default": true
          }
        },
        "question_2": {
          "type": "_barkfam-faq-item"
        },
        "question_3": {
          "type": "_barkfam-faq-item"
        }
      },
      "block_order": ["question_1", "question_2", "question_3"]
    }
  ]
}
{% endschema %}
