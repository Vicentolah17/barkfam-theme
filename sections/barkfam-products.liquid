{% comment %}
  Section contract.
  "Best Sellers" from the approved design (_referencias/design/Home.dc.html,
  "Best sellers"): a centred pill and heading, a grid of product cards from a
  collection (four across on desktop, two on mobile) and a "Shop all" button.
  Cards are snippets/barkfam-product-card.liquid, so add to cart uses Horizon's
  quick add and cart drawer.

  @example
  <!-- templates/index.json, after the banners, with a collection picked -->
{% endcomment %}

{% render 'barkfam-ui' %}

{%- liquid
  assign grid_collection = section.settings.collection
  assign button_link = section.settings.button_link | default: grid_collection.url | default: routes.all_products_collection_url

  assign has_products = false
  if grid_collection != blank and grid_collection.products_count > 0
    assign has_products = true
  endif
-%}

<div
  class="bf-section bf-products"
  style="{% render 'barkfam-surface', background: section.settings.background_color %}"
>
  <div class="bf-container">
    {%- if section.settings.pill != blank or section.settings.heading != blank -%}
      <div class="bf-heading-group">
        {%- if section.settings.pill != blank -%}
          <span class="bf-pill"><span class="bf-pill__dot"></span>{{ section.settings.pill | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_products -%}
      <div class="bf-products__grid">
        {%- for card_product in grid_collection.products limit: section.settings.products_to_show -%}
          {% render 'barkfam-product-card', product: card_product, section_id: section.id %}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="bf-products__grid">
        {%- for placeholder in (1..section.settings.products_to_show) -%}
          <div class="bf-card">
            <span class="bf-card__media">{{ 'product-1' | placeholder_svg_tag: 'bf-card__image' }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="bf-products__footer">
        <a class="bf-btn bf-btn--primary bf-products__button" href="{{ button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .bf-products {
    padding-block-start: var(--bf-py);
    background-color: var(--bf-surface-bg, transparent);
  }

  .bf-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--bf-row-gap) var(--bf-gap);
  }

  .bf-products__footer {
    display: flex;
    justify-content: center;
    margin-block-start: var(--bf-title-gap);
  }

  .bf-products .bf-products__button {
    padding-inline: 32px;
  }

  @media screen and (min-width: 750px) {
    .bf-products__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.barkfam_products",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "pill",
      "label": "t:settings.barkfam_pill",
      "default": "t:text_defaults.barkfam_products_pill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.barkfam_products_heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.barkfam_products_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:settings.barkfam_products_to_show",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.barkfam_products_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link",
      "info": "t:info.barkfam_products_button_link"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    }
  ],
  "presets": [
    {
      "name": "t:names.barkfam_products",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
